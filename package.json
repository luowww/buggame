{
  "name": "reflow-404",
  "private": true,
  "version": "6.3.0",
  "type": "module",
  "description": "RE:FLOW 404《断点之城》——四城探索，从雨港走进白噪雪原；五条网络与风雪主线、三段支线故事、真实横风、稳身与三站风暴投递。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm test && npm run build && node scripts/check-release.mjs",
    "release:check": "npm run verify && node scripts/check-release.mjs --strict"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
